generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int     @id @default(autoincrement())
  name                 String
  phone                String
  password             String
  role                 String
  status               String
  isAvailable          Boolean @default(false)

  identificationValid  Boolean @default(false)
  licenseValid         Boolean @default(false)

  identificationUrl    String?
  licenseUrl           String?
  profilePhotoUrl String?
mainAddress     String?
vehicleType String?
vehiclePlate String?
bio          String?
}

model Task {
  id             Int     @id @default(autoincrement())
  description    String
  status         String
  clientId       Int
  runnerId       Int?
  pickupLat      Float?
  pickupLng      Float?
  dropoffLat     Float?
  dropoffLng     Float?
  runnerLat      Float?
  runnerLng      Float?
  distanceKm     Float?
  estimatedPrice Float?
  rating         Int?
  review         String?  
  deliveryProofUrl String?
  paymentMethod   String?
paymentStatus   String? @default("PENDING")
paymentProofUrl String?
platformFee     Float?
runnerEarnings  Float?
runnerPayoutStatus String? @default("PENDING")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  taskId    Int
  senderId  Int
  text      String
  createdAt DateTime @default(now())
}